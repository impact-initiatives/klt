# ==============================================================================
# KLT (KoboToolbox Loading Tool) Configuration Template
# ==============================================================================
# Copy this file to `.env` and fill in your values.
# The `.env` file is gitignored and should never be committed to version control.
#
# Configuration precedence: CLI arguments > Environment variables > .env file > defaults
# ==============================================================================

# ------------------------------------------------------------------------------
# KoboToolbox Source Credentials (REQUIRED)
# ------------------------------------------------------------------------------
# Your KoboToolbox server URL and API credentials

SOURCES__KOBO_SERVER=https://kobo.yourdomain.org
SOURCES__KOBO_TOKEN=your_kobo_api_token_here
SOURCES__KOBO_PROJECT_VIEW=your_project_view_uid_here


# ------------------------------------------------------------------------------
# Pipeline Configuration (OPTIONAL - defaults provided)
# ------------------------------------------------------------------------------
# Core DLT pipeline settings

# KLT_PIPELINE_NAME=klt
# KLT_DESTINATION=duckdb
# KLT_DATASET_NAME=klt_dataset
# KLT_WRITE_DISPOSITION=merge
# KLT_PROGRESS=log


# ------------------------------------------------------------------------------
# Incremental Loading Filters (OPTIONAL)
# ------------------------------------------------------------------------------
# DateTime filters for incremental data loading
# Format: YYYY-MM-DD or ISO 8601 (e.g., 2024-01-01T00:00:00)
# If not set, CLI defaults to today at 00:00:00 for start dates

# KLT_SUBMISSION_TIME_START=2024-01-01
# KLT_SUBMISSION_TIME_END=
# KLT_ASSET_LAST_SUBMISSION_START=2024-01-01
# KLT_ASSET_LAST_SUBMISSION_END=
# KLT_ASSET_MODIFIED_START=2024-01-01
# KLT_ASSET_MODIFIED_END=


# ------------------------------------------------------------------------------
# Logging Configuration (OPTIONAL)
# ------------------------------------------------------------------------------
# Directory for application log files

# KLT_LOG_DIR=.


# ------------------------------------------------------------------------------
# PostgreSQL Destination Credentials (REQUIRED if using postgres destination)
# ------------------------------------------------------------------------------
# Configure these if KLT_DESTINATION=postgres
# All fields except PORT are REQUIRED when using PostgreSQL as destination
# Not needed if using DuckDB (the default)

# DESTINATION__POSTGRES__CREDENTIALS__HOST=localhost
# DESTINATION__POSTGRES__CREDENTIALS__PORT=5432
# DESTINATION__POSTGRES__CREDENTIALS__DATABASE=your_database_name
# DESTINATION__POSTGRES__CREDENTIALS__USERNAME=your_username
# DESTINATION__POSTGRES__CREDENTIALS__PASSWORD=your_password
# DESTINATION__POSTGRES__CREDENTIALS__CONNECT_TIMEOUT=15


# ==============================================================================
# Notes
# ==============================================================================
#
# 1. KoboToolbox credentials (SOURCES__*) are REQUIRED for the pipeline to run
#
# 2. To use PostgreSQL as destination:
#    - Set KLT_DESTINATION=postgres
#    - Uncomment and fill in all DESTINATION__POSTGRES__CREDENTIALS__* values
#
# 3. For production/CI/CD environments:
#    - Use environment variables or secrets management instead of .env files
#    - See .github/workflows/run-pipeline-dev.yml for examples
#
# 4. DateTime formats accepted:
#    - YYYY-MM-DD (e.g., 2024-01-01)
#    - ISO 8601 (e.g., 2024-01-01T00:00:00)
#    - ISO 8601 with timezone (e.g., 2024-01-01T00:00:00+00:00)
#
# 5. For more information, see the documentation or README.md
#
# ==============================================================================
