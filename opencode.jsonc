{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "dlt": {
      "type": "local",
      "command": [
        "uv",
        "tool",
        "run",
        "--with",
        "dlt-plus==0.9.0",
        "--with",
        "sqlglot",
        "--with",
        "pyarrow",
        "--with",
        "pandas",
        "--with",
